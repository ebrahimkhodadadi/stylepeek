{
  "manifest_version": 3,
  "name": "StylePeek — Design System Extractor",
  "description": "Extract design tokens, colors, typography, spacing, and assets from any website",
  "version": "0.2.0",
  "permissions": ["activeTab", "scripting", "storage", "downloads", "tabs"],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "devtools_page": "src/devtools/devtools.html",
  "commands": {
    "open-panel": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Open StylePeek panel"
    },
    "inspect-mode": {
      "suggested_key": { "default": "Alt+I" },
      "description": "Toggle element inspector"
    }
  }
}
