{
  "name": "@stylepeek/web",
  "version": "0.1.0",
  "description": "Web UI for stylepeek — real-time design system extraction in the browser",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,green \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "vite build && tsup src/server/index.ts --format esm --target node20 --no-dts --out-dir dist/server",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@stylepeek/core": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.0",
    "tailwindcss": "^3.4.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
